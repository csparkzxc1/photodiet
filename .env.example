# Sentry DSN (optional in dev — leave blank to skip runtime Sentry init).
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source map upload during native build.
# Default: disabled. Set to false (or remove) only after configuring
# sentry org/project/auth in ios/sentry.properties.
SENTRY_DISABLE_AUTO_UPLOAD=true

# RevenueCat API keys (used in Phase F).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
